[Unit]
Description=RustVPN Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/ubuntu/rust-vpn-lab
ExecStart=/home/ubuntu/rust-vpn-lab/target/release/server
Restart=always
RestartSec=5
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
